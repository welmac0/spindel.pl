# Copy to .env. Never commit real credentials.

# Email requires a Brevo API key and verified sender; no mock mode.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=sender@example.com
BREVO_SENDER_NAME=Spindel

# Local URLs (use public HTTPS URLs in production).
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Set true for HTTPS; production Compose enforces true.
SESSION_COOKIE_SECURE=false

# Monitoring alert recipient.
ALERT_EMAIL=alerts@example.com

# Build-time flag forwarded by production Compose. Rebuild after changes.
# Native Vite: set in frontend/.env.local or the process environment.
VITE_MAINTENANCE=false