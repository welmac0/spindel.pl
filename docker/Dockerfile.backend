FROM python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /uvx /bin/

WORKDIR /app

# Flush Python logs immediately.
ENV PYTHONUNBUFFERED=1 \
    DATABASE_PATH=/app/data/database.db

COPY pyproject.toml uv.lock README.md ./
COPY src/wymiana_zajec ./src/wymiana_zajec

# Use the exact locked dependency versions without development packages.
RUN uv sync --locked --no-dev 

RUN useradd --create-home app \
    && mkdir -p /app/data \
    && chown -R app:app /app

USER app

EXPOSE 8000

CMD ["uv", "run", "--no-dev", "uvicorn", "wymiana_zajec.main:app", "--host", "0.0.0.0", "--port", "8000"]

# docker build -f docker/Dockerfile.backend -t wymiana-backend .