FROM node:26-alpine3.23 AS builder

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# ci works like npm install --lock
RUN npm ci
COPY frontend/ ./
RUN npm run build

# ten obraz zawiera tylko pliki, bo kopiuje je z buildera. Nie zawiera danych z obrazu node'a
FROM nginx:alpine

# /usr/share/nginx/html jest domyslnie serwowane przez nginx
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
