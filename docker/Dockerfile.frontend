FROM node:26-alpine3.23@sha256:a3024faf41c40992531ecfb00604384665be870a44626afaf181c6d583f89296 AS builder

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
# ci works like npm install --lock
RUN npm ci
COPY frontend/ ./
ARG VITE_MAINTENANCE=false
ENV VITE_MAINTENANCE=$VITE_MAINTENANCE
RUN npm run build

# ten obraz zawiera tylko pliki, bo kopiuje je z buildera. Nie zawiera danych z obrazu node'a
FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de

# /usr/share/nginx/html jest domyslnie serwowane przez nginx
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
