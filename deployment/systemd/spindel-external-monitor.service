[Unit]
Description=Check Spindel public production endpoints from an external host
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=spindel-monitor
Group=spindel-monitor
EnvironmentFile=/etc/spindel-monitor/monitor.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/spindel-external-monitor.sh
StateDirectory=spindel-external-monitor
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6