# systemd unit metadata.
[Unit]
# Name shown in systemd status and logs.
Description=Wymiana Grup PW API
# Start after the network is available.
After=network.target

# Backend process configuration.
[Service]
# Keep the unit active while the Uvicorn process is running.
Type=simple
# Do not run the backend as root.
User=wymiana
# System group used by the backend process.
Group=wymiana
# Directory from which the application is started.
WorkingDirectory=/opt/wymiana-zajec
# Start the production backend without --reload.
ExecStart=/opt/wymiana-zajec/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
# Restart the process after a failure.
Restart=on-failure
# Wait five seconds before restarting.
RestartSec=5
# Inject secrets without storing them in the repository.
EnvironmentFile=/etc/wymiana-zajec/wymiana-zajec.env
# Prevent the process from gaining privileges.
NoNewPrivileges=true
# Use an isolated temporary directory.
PrivateTmp=true
# Deny access to users' home directories.
ProtectHome=true
# Protect system directories from writes.
ProtectSystem=full

# Installation settings for the system boot target.
[Install]
# Start with the normal multi-user system target.
WantedBy=multi-user.target