[Unit]
Description=Check Wymiana Grup PW Docker service health
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=spindel
Group=spindel
SupplementaryGroups=docker
WorkingDirectory=/opt/wymiana-zajec
ExecStart=/opt/wymiana-zajec/scripts/check_health_inner.sh
EnvironmentFile=/opt/wymiana-zajec/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StateDirectory=wymiana-zajec-health
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
