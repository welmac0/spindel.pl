# systemd unit metadata.
[Unit]
# Name shown in systemd status and logs.
Description=Check Wymiana Grup PW API health

# One-shot health check configuration.
[Service]
# Run the check once and then exit.
Type=oneshot
# Do not run the monitor as root.
User=wymiana
# System group used by the monitor.
Group=wymiana
# Project directory used as the working directory.
WorkingDirectory=/opt/wymiana-zajec
# Check the health endpoint and alert on a state transition.
ExecStart=/opt/wymiana-zajec/scripts/check_health.sh
# Pass Brevo configuration and ALERT_EMAIL to the script.
EnvironmentFile=/etc/wymiana-zajec/wymiana-zajec.env
# Create /run/wymiana-zajec-health for the monitor state file.
RuntimeDirectory=wymiana-zajec-health
# Prevent the monitor from gaining privileges.
NoNewPrivileges=true
# Use an isolated temporary directory.
PrivateTmp=true
# Deny access to users' home directories.
ProtectHome=true
# Protect system directories from writes.
ProtectSystem=full